# 部署到 /etc/systemd/system/weather-server.service
# 说明：第一实例（8082）。密钥与凭证走环境变量，不写死在单元文件里入库。
# 服务器上真实的 Environment 值（DB/LLM/JWT）写在 /etc/systemd/system/weather-server.service，
# 本文件是它的版本化模板，修改后记得 daemon-reload。

[Unit]
Description=Weather proxy backend (SpringBoot) #1
After=network.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu
ExecStart=/usr/bin/java -Xmx256m -XX:MaxMetaspaceSize=128m -jar /home/ubuntu/weather-server-0.0.1-SNAPSHOT.jar --server.port=8082
Restart=always
RestartSec=3
Environment=DB_USER=app
Environment=DB_PASS=CHANGE_ME
Environment=LLM_API_KEY=CHANGE_ME
Environment=JWT_PRIVATE_KEY_PATH=/home/ubuntu/secrets/ed25519-private.pem
Environment=JWT_PUBLIC_KEY_PATH=/home/ubuntu/secrets/ed25519-public.pem

[Install]
WantedBy=multi-user.target
